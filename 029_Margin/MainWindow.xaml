<Window x:Class="_029_Margin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_029_Margin"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="500">
    <Grid Background="CadetBlue">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Margin="10 10 10 5">Button1</Button>
        <Button Margin="10 5 10 5" Grid.Row="1">Button2</Button>
        <Button Margin="10 5 10 10" Grid.Row="2">Button3</Button>
    </Grid>
</Window>
