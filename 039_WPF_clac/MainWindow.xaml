<Window x:Class="_039_WPF_clac.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_039_WPF_clac"
        mc:Ignorable="d"
        Title="내가 만든 계산기" MinHeight="550" Height="550" MinWidth="400" Width="450" Background="#FFE8E8E8">
    <DockPanel>
        <Menu Padding="5" DockPanel.Dock="Top" Background="WhiteSmoke">
            <MenuItem Header="선택">
                <MenuItem Header="표준"/>
                <MenuItem Header="공학용"/>
                <MenuItem Header="프로그래밍용"/>
            </MenuItem>
            <MenuItem Header="끝내기" Click="MenuItem_Click"/>
        </Menu>
        <Grid Height="100" DockPanel.Dock="Top">
            <TextBlock x:Name="txtExp" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" FontSize="16"></TextBlock>
            <TextBlock x:Name="txtResult" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="40" FontWeight="Bold" Margin="10 10 15 10">0</TextBlock>
        </Grid>
        <Grid DockPanel.Dock="Top" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnMC" Grid.Column="0" Content="MC" FontSize="14" FontWeight="Bold" Click="btnMC_Click"/>
            <Button x:Name="btnMR" Grid.Column="1" Content="MR" FontSize="14" FontWeight="Bold" Click="btnMR_Click"/>
            <Button x:Name="btnMPlus" Grid.Column="2" Content="M+" FontSize="14" FontWeight="Bold" Click="btnMPlus_Click"/>
            <Button x:Name="btnMMinus" Grid.Column="3" Content="M-" FontSize="14" FontWeight="Bold" Click="btnMMinus_Click"/>
            <Button x:Name="btnMS" Grid.Column="4" Content="MS" FontSize="14" FontWeight="Bold" Click="btnMS_Click"/>
        </Grid>
            <Grid MinHeight="360" DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!--첫번쨰 줄-->
            <Button x:Name="btnPercent" Grid.Row="0" Grid.Column="0" BorderThickness="0" FontSize="18" Margin="2, 1, 1, 1" Background="#FFFAFAFA" Click="btnPercent_Click">%</Button>
            <Button x:Name="btnCE" Grid.Row="0" Grid.Column="1" BorderThickness="0" FontSize="18" Margin="1" Background="#FFFAFAFA" Click="btnCE_Click">CE</Button>
            <Button x:Name="btnC" Grid.Row="0" Grid.Column="2" BorderThickness="0" FontSize="18" Margin="1" Background="#FFFAFAFA" Click="btnC_Click">C</Button>
            <Button x:Name="btnDelete" Grid.Row="0" Grid.Column="3" BorderThickness="0" FontSize="18" Margin="1, 1, 2 ,1" Background="#FFFAFAFA" Click="btnDelete_Click">⌫</Button>
            <!--두번쨰 줄-->
            <Button x:Name="btnRecip" Grid.Row="1" Grid.Column="0" BorderThickness="0" FontSize="18" Margin="2, 1, 1, 1" Background="#FFFAFAFA" Click="btnRecip_Click">1/x</Button>
            <Button x:Name="btnSqr" Grid.Row="1" Grid.Column="1" BorderThickness="0" FontSize="18" Margin="1" Background="#FFFAFAFA" Click="btnSqr_Click">x²</Button>
            <Button x:Name="btnSqrt" Grid.Row="1" Grid.Column="2" BorderThickness="0" FontSize="18" Margin="1" Background="#FFFAFAFA" Click="btnSqrt_Click">√</Button>
            <Button x:Name="btnDivide" Grid.Row="1" Grid.Column="3" BorderThickness="0" FontSize="18" Margin="1, 1, 2 ,1" Background="#FFFAFAFA" Click="btnPlus_Click">÷</Button>
            <!--세번쨰 줄-->
            <Button x:Name="btn7" Grid.Row="2" Grid.Column="0" BorderThickness="0" FontSize="18" Margin="2, 1, 1, 1" Background="White" Click="btn1_Click">7</Button>
            <Button x:Name="btn8" Grid.Row="2" Grid.Column="1" BorderThickness="0" FontSize="18" Margin="1" Background="White" Click="btn1_Click">8</Button>
            <Button x:Name="btn9" Grid.Row="2" Grid.Column="2" BorderThickness="0" FontSize="18" Margin="1" Background="White" Click="btn1_Click">9</Button>
            <Button x:Name="btnTimes" Grid.Row="2" Grid.Column="3" BorderThickness="0" FontSize="18" Margin="1, 1, 2 ,1" Background="#FFFAFAFA" Click="btnPlus_Click">×</Button>
            <!--네번쨰 줄-->
            <Button x:Name="btn4" Grid.Row="3" Grid.Column="0" BorderThickness="0" FontSize="18" Margin="2, 1, 1, 1" Background="White" Click="btn1_Click">4</Button>
            <Button x:Name="btn5" Grid.Row="3" Grid.Column="1" BorderThickness="0" FontSize="18" Margin="1" Background="White" Click="btn1_Click">5</Button>
            <Button x:Name="btn6" Grid.Row="3" Grid.Column="2" BorderThickness="0" FontSize="18" Margin="1" Background="White" Click="btn1_Click">6</Button>
            <Button x:Name="btnMinus" Grid.Row="3" Grid.Column="3" BorderThickness="0" FontSize="18" Margin="1, 1, 2 ,1" Background="#FFFAFAFA" Click="btnPlus_Click">-</Button>
            <!--다섯번쨰 줄-->
            <Button x:Name="btn1" Grid.Row="4" Grid.Column="0" BorderThickness="0" FontSize="18" Margin="2, 1, 1, 1" Background="White" Click="btn1_Click">1</Button>
            <Button x:Name="btn2" Grid.Row="4" Grid.Column="1" BorderThickness="0" FontSize="18" Margin="1" Background="White" Click="btn1_Click">2</Button>
            <Button x:Name="btn3" Grid.Row="4" Grid.Column="2" BorderThickness="0" FontSize="18" Margin="1" Background="White" Click="btn1_Click">3</Button>
            <Button x:Name="btnPlus" Grid.Row="4" Grid.Column="3" BorderThickness="0" FontSize="18" Margin="1, 1, 2 ,1" Background="#FFFAFAFA" Click="btnPlus_Click">+</Button>
            <!--여섯번쨰 줄-->
            <Button x:Name="btPlusMinus" Grid.Row="5" Grid.Column="0" BorderThickness="0" FontSize="18" Margin="2, 1, 1, 1" Background="#FFFAFAFA" Click="btPlusMinus_Click">±</Button>
            <Button x:Name="btn0" Grid.Row="5" Grid.Column="1" BorderThickness="0" FontSize="18" Margin="1" Background="White" Click="btn1_Click">0</Button>
            <Button x:Name="btnDot" Grid.Row="5" Grid.Column="2" BorderThickness="0" FontSize="18" Margin="1" Background="#FFFAFAFA" Click="btnDot_Click">.</Button>
            <Button x:Name="btnEqual" Grid.Row="5" Grid.Column="3" BorderThickness="0" FontSize="18" Margin="1, 1, 2 ,1" Background="#FF0067C0" Foreground="White" Content="=" Click="btnEqual_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </DockPanel>
</Window>
